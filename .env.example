# HTTP dashboard + legacy JSON API.
PORT=8000

# gRPC broker protocol (Enqueue / Consume stream / admin).
GRPC_PORT=9090

# Soft cap on pending jobs across all types; Enqueue returns ResourceExhausted.
JOB_QUEUE_SIZE=1000

# Attempt budget before a job goes to the DLQ. Can be overridden per-job on Enqueue.
MAX_RETRIES=3

# Exponential-backoff base for nack / lease-expiry retries (seconds).
BASE_BACKOFF_SECONDS=1

# Graceful shutdown deadline for HTTP + gRPC + workers (seconds).
SHUTDOWN_TIMEOUT_SECONDS=10

# Default lease length when a Consume client omits it (seconds).
DEFAULT_LEASE_SECONDS=60

# Hard cap on client-requested lease length (seconds).
MAX_LEASE_SECONDS=300

# How often the lease-expiry watcher sweeps (seconds).
LEASE_SWEEP_INTERVAL_SECONDS=1

# Cap on client-requested prefetch count.
MAX_PREFETCH=64
